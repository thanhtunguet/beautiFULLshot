{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/itsddvn/beautiFULLshot/releases/latest/download/latest.json"
      ],
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklFWkNRelUwUkVZd09FVTJSVFJCT1RVS1VsZFRWbE50Tms4NFJUTkdLemxFYW14YWVrTXpTR3B4ZW13cmFUTllVbkZVTUd0eVYybElSV2M0T0UxcGVDdE9ObE5wVEhjd2Nrc0s=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "productName": "beautiFULLshot",
  "version": "1.1.2",
  "identifier": "com.beautyfullshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "beautiFULLshot",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://images.unsplash.com; connect-src ipc: http://ipc.localhost http://tauri.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "itsddvn",
    "homepage": "https://beautifullshot.itsdd.vn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "fileAssociations": [
      {
        "ext": [
          "bshot"
        ],
        "name": "beautiFULLshot Project",
        "description": "beautiFULLshot project file",
        "role": "Editor",
        "mimeType": "application/x-beautyfullshot-project",
        "rank": "Owner"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
        "description": "PNG image file",
        "role": "Editor",
        "mimeType": "image/png",
        "rank": "Default"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG Image",
        "description": "JPEG image file",
        "role": "Editor",
        "mimeType": "image/jpeg",
        "rank": "Default"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP Image",
        "description": "WebP image file",
        "role": "Editor",
        "mimeType": "image/webp",
        "rank": "Default"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF Image",
        "description": "GIF image file",
        "role": "Editor",
        "mimeType": "image/gif",
        "rank": "Default"
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "Bitmap Image",
        "description": "Bitmap image file",
        "role": "Editor",
        "mimeType": "image/bmp",
        "rank": "Default"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF Image",
        "description": "TIFF image file",
        "role": "Editor",
        "mimeType": "image/tiff",
        "rank": "Default"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG Image",
        "description": "Scalable Vector Graphics image file",
        "role": "Editor",
        "mimeType": "image/svg+xml",
        "rank": "Default"
      }
    ],
    "shortDescription": "Screenshot beautification app",
    "longDescription": "Capture, annotate, and beautify screenshots with gradient backgrounds and export options. Cross-platform support for Windows, macOS, and Linux.",
    "copyright": "2025 beautiFULLshot",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "graphics"
      },
      "rpm": {
        "epoch": 0
      }
    }
  }
}